"use client";

import { useState, useMemo } from "react";
import { useTranslations, useLocale } from "next-intl";
import { getArticlesByFilter } from "@/lib/articles";
import { SOLUTION_TABS, INDUSTRIES, SIZE_TABS } from "@/lib/constants";
import ArticleCard from "../cards/ArticleCard";
import SectionWrapper from "../ui/SectionWrapper";

export default function ArticleFeed() {
  const t = useTranslations("filters");
  const tExplore = useTranslations("explore");
  const locale = useLocale() as "es" | "en";
  const [activeSolution, setActiveSolution] = useState("");
  const [activeIndustry, setActiveIndustry] = useState("");
  const [activeSize, setActiveSize] = useState("");

  const hasActiveFilters = !!(activeSolution || activeIndustry || activeSize);

  const filtered = useMemo(
    () =>
      getArticlesByFilter({
        solution: activeSolution || undefined,
        industry: activeIndustry || undefined,
        size: activeSize || undefined,
      }),
    [activeSolution, activeIndustry, activeSize]
  );

  const clearFilters = () => {
    setActiveSolution("");
    setActiveIndustry("");
    setActiveSize("");
  };

  return (
    <SectionWrapper className="py-20 tablet:py-28" id="explorar">
      <div className="relative z-10">
        {/* Header */}
        <div data-animate>
          <p className="mb-3 font-inter text-[11px] font-semibold uppercase tracking-[0.15em] text-gray-400">
            {tExplore("eyebrow")}
          </p>
          <h2 className="font-sora text-[32px] font-light text-gray-900 tablet:text-[44px]">
            {tExplore("title")}
            <span className="text-[#E26153]">{tExplore("titleAccent")}</span>
          </h2>
        </div>

        {/* Solution tabs (colored pills) */}
        <div className="mt-8 flex flex-wrap gap-2" data-animate>
          {SOLUTION_TABS.filter((s) => s.key !== "all").map((tab) => (
            <button
              key={tab.key}
              onClick={() =>
                setActiveSolution(activeSolution === tab.key ? "" : tab.key)
              }
              className={`rounded-full px-5 py-2 font-inter text-2xs font-medium transition-colors ${
                activeSolution === tab.key
                  ? "bg-[#E26153] text-white"
                  : "border border-gray-200 bg-white text-gray-600 hover:border-gray-300 hover:bg-gray-50"
              }`}
            >
              {typeof tab.label === "string" ? tab.label : tab.label[locale]}
            </button>
          ))}
        </div>

        {/* Filter dropdowns row */}
        <div className="mt-4 flex flex-wrap items-center gap-3" data-animate>
          {/* Industry */}
          <div className="relative">
            <select
              value={activeIndustry}
              onChange={(e) => setActiveIndustry(e.target.value)}
              className="appearance-none rounded-full border border-gray-200 bg-white py-2 pl-4 pr-8 font-inter text-micro text-gray-600 outline-none transition-colors focus:border-[#E26153]"
            >
              <option value="">{t("industry")}</option>
              {INDUSTRIES.map((ind) => (
                <option key={ind.slug} value={ind.slug}>
                  {ind.label[locale]}
                </option>
              ))}
            </select>
            <svg
              className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-400"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>

          {/* Size */}
          <div className="relative">
            <select
              value={activeSize}
              onChange={(e) => setActiveSize(e.target.value)}
              className="appearance-none rounded-full border border-gray-200 bg-white py-2 pl-4 pr-8 font-inter text-micro text-gray-600 outline-none transition-colors focus:border-[#E26153]"
            >
              <option value="">{t("size")}</option>
              {SIZE_TABS.filter((s) => s.key !== "all").map((tab) => (
                <option key={tab.key} value={tab.key}>
                  {tab.label[locale]}
                </option>
              ))}
            </select>
            <svg
              className="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-gray-400"
              width="12"
              height="12"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              strokeWidth="2"
            >
              <path d="m6 9 6 6 6-6" />
            </svg>
          </div>

          {/* Clear */}
          {hasActiveFilters && (
            <button
              onClick={clearFilters}
              className="font-inter text-micro font-medium text-[#E26153] transition-colors hover:underline"
            >
              {t("clear")}
            </button>
          )}

          {/* Count */}
          <span className="ml-auto font-inter text-micro text-gray-400">
            {t("showing")} {filtered.length} {t("results")}
          </span>
        </div>

        {/* Grid */}
        {filtered.length > 0 ? (
          <div className="mt-10 grid grid-cols-1 gap-6 tablet:grid-cols-2">
            {filtered.map((article, i) => (
              <ArticleCard
                key={article.slug}
                article={article}
                locale={locale}
                index={i}
              />
            ))}
          </div>
        ) : (
          <div className="mt-16 text-center">
            <p className="font-inter text-xs text-gray-500">
              {t("noResults")}
            </p>
            <button
              onClick={clearFilters}
              className="mt-4 font-inter text-2xs font-semibold text-[#E26153] hover:underline"
            >
              {t("clear")}
            </button>
          </div>
        )}
      </div>
    </SectionWrapper>
  );
}
